# Copy to .env and fill in what you need. Everything here is optional —
# the app runs fine with none of it set, it just measures nothing.
#
# Only VITE_-prefixed variables reach the browser. That prefix is load-bearing:
# the GA ID used to be read as REACT_APP_GA_TRACKING_ID, which Vite never
# exposes, so it silently resolved to undefined for the life of the project.

# --- Analytics (client-side, gated behind visitor consent) -------------------

# Google Analytics 4 measurement ID. Unset means GA never initialises.
VITE_GA_TRACKING_ID=

# Microsoft Clarity project ID. Unset means the tag is never injected.
VITE_CLARITY_PROJECT_ID=

# --- Contact form ------------------------------------------------------------

# Web3Forms access key backing /contact. Public by design, but keeping it in
# env means a fork doesn't inherit a direct line into someone else's inbox.
# Get one free at https://web3forms.com
VITE_WEB3FORMS_ACCESS_KEY=

# --- Feature flags -----------------------------------------------------------

# 'true' plays the cinematic terminal boot sequence on first load.
VITE_LOADING_SCREEN_ENABLED=false

# 'true' shows the under-construction ribbon in the header.
VITE_UNDER_CONSTRUCTION_ENABLED=false

# --- Build-time only (never shipped to the browser) --------------------------

# Used by @sentry/vite-plugin to upload source maps. Without these the build
# still succeeds; it just skips the upload and deletes the maps locally.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
