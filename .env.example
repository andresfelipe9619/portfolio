# Copy to .env and fill in what you need. Everything here is optional — the
# app runs fine with every line left blank.
#
# Production analytics IDs are NOT set here: they live in the committed
# .env.production, which only `vite build` loads. So a local `npm run dev`
# never sends your clicking-around into the production dashboards, and a
# deploy can't lose analytics because someone forgot the Vercel dashboard.
# Anything you set here, or in Vercel, overrides .env.production.
#
# Only VITE_-prefixed variables reach the browser. That prefix is load-bearing:
# the GA ID used to be read as REACT_APP_GA_TRACKING_ID, which Vite never
# exposes, so it silently resolved to undefined for the life of the project.

# --- Analytics (client-side, gated behind visitor consent) -------------------

# Google Analytics 4 measurement ID. Unset means GA never initialises.
# (Forking? Put yours in .env.production, not here.)
VITE_GA_TRACKING_ID=

# Microsoft Clarity project ID. Unset means the tag is never injected.
VITE_CLARITY_PROJECT_ID=

# --- Error reporting ---------------------------------------------------------

# Sentry DSN. The production value lives in .env.production, where a test keeps
# vercel.json's CSP in step with it. Set it here only to try Sentry from
# `npm run dev`. Left blank, the SDK records and sends nothing.
VITE_SENTRY_DSN=

# --- Contact form ------------------------------------------------------------

# Web3Forms access key backing /contact. Blank falls back to the built-in key,
# so the form works out of the box — which, if you've forked this, means
# messages land in Andrés's inbox. Get your own free at https://web3forms.com
VITE_WEB3FORMS_ACCESS_KEY=

# --- Feature flags -----------------------------------------------------------

# 'true' plays the cinematic terminal boot sequence on first load.
VITE_LOADING_SCREEN_ENABLED=false

# 'true' shows the under-construction ribbon in the header.
VITE_UNDER_CONSTRUCTION_ENABLED=false

# --- Build-time only (never shipped to the browser) --------------------------

# Used by @sentry/vite-plugin to upload source maps. Without these the build
# still succeeds; it just skips the upload and deletes the maps locally.
# SENTRY_PROJECT must be the project VITE_SENTRY_DSN belongs to. If it isn't,
# errors and their source maps land in different projects, and the alerts
# come from the one that isn't getting any errors.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
